# Local PostgreSQL connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/smart_outfit
# Generate a long random secret (at least 32 characters)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
NODE_ENV=development
PORT=3000
# First admin account is created automatically if it does not exist
ADMIN_NAME=SMART OUTFIT Admin
ADMIN_EMAIL=admin@smartoutfit.com
ADMIN_PASSWORD=ChangeThisPassword123!
